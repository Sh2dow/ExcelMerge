<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ExcelMerge.Desktop"
        x:Class="ExcelMerge.Desktop.DiagnosticsWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{DynamicResource Diagnostics}" Width="720" Height="460"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="14">
    <TextBlock Text="{DynamicResource OperationLog}" FontSize="16" FontWeight="SemiBold" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Margin="0,10" FontFamily="Consolas" FontSize="11" />
    <Button Grid.Row="2" Content="{DynamicResource Close}" HorizontalAlignment="Right" Click="CloseWindow" />
  </Grid>
</Window>

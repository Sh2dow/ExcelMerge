<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ExcelMerge.Desktop"
        xmlns:converters="using:ExcelMerge.Desktop.Converters"
        x:Class="ExcelMerge.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{DynamicResource AppTitle}"
        Icon="avares://ExcelMerge.Desktop/Assets/app.ico"
        Width="1500" Height="920" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBrush}"
        KeyDown="WindowKeyDown"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="WindowDragOver"
        DragDrop.Drop="WindowDrop">
  <Window.Resources>
    <converters:BoolToGridLengthConverter x:Key="WorksheetsPanelWidth" TrueValue="260" FalseValue="0" />
    <converters:BoolToGridLengthConverter x:Key="InspectorPanelWidth" TrueValue="310" FalseValue="0" />
    <converters:BoolToGridLengthConverter x:Key="SplitterWidth" TrueValue="5" FalseValue="0" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.topbar">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="#30363C" />
      <Setter Property="BorderBrush" Value="#505A63" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F2F5F7" />
    </Style>
    <Style Selector="Button.topbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3C444C" />
      <Setter Property="BorderBrush" Value="#707B85" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.topbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1C2126" />
      <Setter Property="BorderBrush" Value="#66717B" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.topbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#292F34" />
      <Setter Property="BorderBrush" Value="#394047" />
      <Setter Property="Foreground" Value="#8E99A3" />
    </Style>

    <Style Selector="Button.topbar.topbarPrimary">
      <Setter Property="Background" Value="#1769AA" />
      <Setter Property="BorderBrush" Value="#2B7DBA" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.topbar.topbarPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#217CBD" />
      <Setter Property="BorderBrush" Value="#4A96CC" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.topbar.topbarPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0F568F" />
      <Setter Property="BorderBrush" Value="#2775AD" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.topbar.topbarPrimary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#304B60" />
      <Setter Property="BorderBrush" Value="#405E74" />
      <Setter Property="Foreground" Value="#AEBEC9" />
    </Style>

    <Style Selector="ToggleButton.modeSwitch">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="#30363C" />
      <Setter Property="BorderBrush" Value="#505A63" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#E7EBEE" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.modeSwitch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3C444C" />
      <Setter Property="BorderBrush" Value="#707B85" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.modeSwitch:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1C2126" />
      <Setter Property="BorderBrush" Value="#66717B" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.modeSwitch:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#292F34" />
      <Setter Property="BorderBrush" Value="#394047" />
      <Setter Property="Foreground" Value="#8E99A3" />
    </Style>
    <Style Selector="ToggleButton.modeSwitch:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1769AA" />
      <Setter Property="BorderBrush" Value="#3A87C1" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.modeSwitch:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#217CBD" />
      <Setter Property="BorderBrush" Value="#57A0D4" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.modeSwitch:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0F568F" />
      <Setter Property="BorderBrush" Value="#2775AD" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.modeSwitch:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#304B60" />
      <Setter Property="BorderBrush" Value="#405E74" />
      <Setter Property="Foreground" Value="#AEBEC9" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Border Grid.Row="0" Background="#24282C" BorderBrush="#111519"
            BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,18,*,Auto,Auto,Auto" ColumnSpacing="7">
        <ToggleButton x:Name="CompareModeButton" Classes="modeSwitch" Content="{DynamicResource Compare}"
                      IsChecked="{Binding IsCompareMode, Mode=OneWay}"
                      Click="SelectCompareMode" MinWidth="86" />
        <ToggleButton x:Name="MergeModeButton" Grid.Column="1" Classes="modeSwitch"
                      Content="{DynamicResource Merge}"
                      IsChecked="{Binding IsMergeMode, Mode=OneWay}"
                      Click="SelectMergeMode" MinWidth="86" />
        <TextBlock Grid.Column="3" Text="ExcelMerge" Foreground="#F5F7F8" FontSize="17"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="4" Classes="topbar" Content="{DynamicResource Diagnostics}"
                Click="OpenDiagnostics" />
        <Button Grid.Column="5" Classes="topbar" Content="{DynamicResource Settings}"
                Click="OpenSettings" />
        <Button Grid.Column="6" Classes="topbar topbarPrimary" Content="{DynamicResource SaveResult}"
                Click="SaveResult" IsEnabled="{Binding CanSave}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
            Padding="12,9" IsVisible="{Binding InputsExpanded}">
      <Grid ColumnDefinitions="72,*,38" RowDefinitions="Auto,Auto,Auto"
            ColumnSpacing="8" RowSpacing="6">
        <TextBlock Grid.Row="0" Classes="label" Text="{DynamicResource Base}"
                   VerticalAlignment="Center" IsVisible="{Binding IsMergeMode}" />
        <TextBox Grid.Row="0" Grid.Column="1" Classes="compact" Text="{Binding BasePath, Mode=TwoWay}"
                 PlaceholderText="BASE .xlsx, .csv, or .tsv" IsVisible="{Binding IsMergeMode}" />
        <Button Grid.Row="0" Grid.Column="2" Content="..." Click="BrowseBase"
                ToolTip.Tip="{DynamicResource Browse}" IsVisible="{Binding IsMergeMode}" />

        <TextBlock Grid.Row="1" Classes="label" Text="{DynamicResource Local}"
                   Foreground="{DynamicResource LocalTextBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Classes="compact" Text="{Binding LocalPath, Mode=TwoWay}"
                 PlaceholderText="LOCAL .xlsx, .csv, or .tsv" />
        <Button Grid.Row="1" Grid.Column="2" Content="..." Click="BrowseLocal"
                ToolTip.Tip="{DynamicResource Browse}" />

        <TextBlock Grid.Row="2" Classes="label" Text="{DynamicResource Remote}"
                   Foreground="{DynamicResource RemoteTextBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Classes="compact" Text="{Binding RemotePath, Mode=TwoWay}"
                 PlaceholderText="REMOTE .xlsx, .csv, or .tsv" />
        <Button Grid.Row="2" Grid.Column="2" Content="..." Click="BrowseRemote"
                ToolTip.Tip="{DynamicResource Browse}" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="{DynamicResource CommandBarBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
            Padding="12,7">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,18,*,Auto,Auto" ColumnSpacing="7">
        <Button Classes="primary" Content="{DynamicResource Open}" Command="{Binding RunCommand}" MinWidth="82" />
        <Button Grid.Column="1" Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" />
        <Button Grid.Column="2" Content="{DynamicResource Swap}" Command="{Binding SwapSidesCommand}" />
        <CheckBox Grid.Column="3" Content="{DynamicResource HideUnchanged}"
                  IsChecked="{Binding HideUnchanged}" VerticalAlignment="Center" />
        <Button Grid.Column="4" Content="{Binding InputToggleText}" Command="{Binding ToggleInputsCommand}" />
        <ToggleButton Grid.Column="5" Content="{DynamicResource Sheets}"
                      IsChecked="{Binding WorksheetsPanelVisible}" VerticalAlignment="Center" />
        <ToggleButton Grid.Column="6" Content="{DynamicResource Inspector}"
                      IsChecked="{Binding InspectorPanelVisible}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="8" Text="{Binding Status}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="9" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                     IsIndeterminate="{Binding ProgressIndeterminate}" IsVisible="{Binding IsBusy}"
                     Width="160" Height="8" VerticalAlignment="Center" />
        <TextBlock Grid.Column="10" Text="{Binding ConflictSummary}" Foreground="{DynamicResource ConflictTextBrush}"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding WorksheetsPanelVisible, Converter={StaticResource WorksheetsPanelWidth}}" />
        <ColumnDefinition Width="{Binding WorksheetsPanelVisible, Converter={StaticResource SplitterWidth}}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{Binding InspectorPanelVisible, Converter={StaticResource SplitterWidth}}" />
        <ColumnDefinition Width="{Binding InspectorPanelVisible, Converter={StaticResource InspectorPanelWidth}}" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0"
              IsVisible="{Binding WorksheetsPanelVisible}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="{DynamicResource Sheets}" FontWeight="SemiBold"
                     Margin="12,10,12,7" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Margin="5,0" MaxHeight="150">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:SheetItemViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="5,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,8,12,5"
                IsVisible="{Binding IsMergeMode}">
            <TextBlock Text="{DynamicResource Conflicts}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Conflicts.Count}" Foreground="{DynamicResource ConflictTextBrush}"
                       FontSize="11" VerticalAlignment="Center" />
          </Grid>
          <ListBox x:Name="ConflictNavigator" Grid.Row="3" ItemsSource="{Binding Conflicts}"
                   SelectedItem="{Binding SelectedConflict, Mode=TwoWay}"
                   PointerPressed="ConflictNavigatorPointerPressed"
                   IsVisible="{Binding IsMergeMode}"
                   Background="Transparent" BorderThickness="0" Margin="5,0,5,8"
                   AutomationProperties.Name="Conflict navigator">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:ConflictItemViewModel">
                <Grid ColumnDefinitions="58,*,Auto" Margin="6,5"
                      AutomationProperties.Name="{Binding Location}">
                  <TextBlock Text="{Binding Location}" FontWeight="SemiBold"
                             FontFamily="Consolas" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="10"
                             Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding ResolutionText}" FontSize="9"
                             Foreground="{DynamicResource ResolutionTextBrush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2" Text="{DynamicResource Recent}" FontWeight="SemiBold"
                     Margin="12,8,12,5" IsVisible="{Binding IsCompareMode}" />
          <ListBox Grid.Row="3" ItemsSource="{Binding RecentSessions}" SelectionChanged="RecentSelected"
                    IsVisible="{Binding IsCompareMode}"
                    Background="Transparent" BorderThickness="0" Margin="5,0,5,8">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:RecentItemViewModel">
                <StackPanel Margin="5,3">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="11" />
                  <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" ResizeDirection="Columns"
                    IsVisible="{Binding WorksheetsPanelVisible}" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource ContentBrush}">
        <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
          <Grid ColumnDefinitions="180,Auto,Auto,Auto,Auto,18,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
            <TextBox x:Name="SearchBox" Grid.Column="0" Classes="compact" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Search}" />
            <CheckBox Grid.Column="1" Content="{DynamicResource Exact}" IsChecked="{Binding SearchExact}" />
            <CheckBox Grid.Column="2" Content="{DynamicResource CaseSensitive}" IsChecked="{Binding SearchCaseSensitive}" />
            <CheckBox Grid.Column="3" Content="{DynamicResource Regex}" IsChecked="{Binding SearchRegex}" />
            <Button Grid.Column="4" Content="{DynamicResource Search}" Command="{Binding SearchCommand}" />
            <Button Grid.Column="6" Content="&#x2190;" Command="{Binding PreviousChangeCommand}"
                    ToolTip.Tip="{DynamicResource Previous}" />
            <Button Grid.Column="7" Content="&#x2192;" Command="{Binding NextChangeCommand}"
                    ToolTip.Tip="{DynamicResource Next}" />
            <TextBlock Grid.Column="8" Text="{Binding SearchSummary}" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" />
            <Button Grid.Column="9" Content="{DynamicResource CopyTsv}" Click="CopyTsv" />
            <Button Grid.Column="10" Content="{DynamicResource CopyCsv}" Click="CopyCsv" />
          </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="*,18" ColumnDefinitions="*,*,18,72">
          <local:VirtualDiffGrid x:Name="DiffGrid" Grid.ColumnSpan="2"
                                   Document="{Binding GridDocument}"
                                   AutomationProperties.Name="{DynamicResource ComparisonGrid}" />
          <ScrollBar x:Name="VerticalScrollBar" Grid.Column="2"
                     Orientation="Vertical" Visibility="Visible" AllowAutoHide="False"
                     SmallChange="1" Margin="1,0,0,0"
                     ValueChanged="VerticalScrollValueChanged"
                     AutomationProperties.Name="Scroll rows" />
          <local:DiffChangeMap x:Name="ChangeMap" Grid.Column="3"
                               Document="{Binding GridDocument}" Margin="1,0,0,0"
                               ToolTip.Tip="Change map"
                               AutomationProperties.Name="Change map" />
          <Border Grid.Row="1" Grid.ColumnSpan="4" Background="{DynamicResource ChromeBrush}"
                   BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0"
                   IsHitTestVisible="False" />
          <ScrollBar x:Name="LocalHorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                     Orientation="Horizontal" Visibility="Visible" AllowAutoHide="False"
                     SmallChange="1" Margin="48,1,2,1"
                     ValueChanged="HorizontalScrollValueChanged"
                     AutomationProperties.Name="Scroll local columns" />
          <ScrollBar x:Name="RemoteHorizontalScrollBar" Grid.Row="1" Grid.Column="1"
                     Orientation="Horizontal" Visibility="Visible" AllowAutoHide="False"
                     SmallChange="1" Margin="50,1,2,1"
                     ValueChanged="HorizontalScrollValueChanged"
                     AutomationProperties.Name="Scroll remote columns" />
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" Background="{DynamicResource PanelBorderBrush}" ResizeDirection="Columns"
                    IsVisible="{Binding InspectorPanelVisible}" />

      <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,0,0,0"
              IsVisible="{Binding InspectorPanelVisible}">
        <TabControl>
          <TabItem Header="{DynamicResource Inspector}">
            <ScrollViewer>
              <StackPanel Margin="12" Spacing="8">
                <TextBlock Text="{Binding Inspector.Address}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Classes="label" Text="{DynamicResource Base}" />
                <TextBox Text="{Binding Inspector.BaseValue}" IsReadOnly="True" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{DynamicResource Local}" Foreground="{DynamicResource LocalTextBrush}" />
                <TextBox Text="{Binding Inspector.LocalValue}" IsReadOnly="True" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{DynamicResource Remote}" Foreground="{DynamicResource RemoteTextBrush}" />
                <TextBox Text="{Binding Inspector.RemoteValue}" IsReadOnly="True" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{DynamicResource Result}" />
                <TextBox Text="{Binding Inspector.ResultValue}" IsReadOnly="True" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Classes="label" Text="{DynamicResource Type}" />
                  <TextBlock Grid.Column="1" Text="{Binding Inspector.ValueType}" />
                  <TextBlock Grid.Row="1" Classes="label" Text="{DynamicResource Formula}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Inspector.Formula}" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{DynamicResource Conflicts}" IsVisible="{Binding IsMergeMode}">
            <ScrollViewer>
              <StackPanel Margin="12" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding SelectedConflict.Location}" FontSize="17"
                             FontWeight="SemiBold" FontFamily="Consolas" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedConflict.ResolutionText}"
                             Foreground="{DynamicResource ConflictTextBrush}" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectedConflict.Kind}"
                             Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </Grid>
                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" />

                <TextBlock Classes="label" Text="{DynamicResource Base}" />
                <TextBox Text="{Binding SelectedConflict.BaseValue, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{DynamicResource Local}" Foreground="{DynamicResource LocalTextBrush}" />
                <TextBox Text="{Binding SelectedConflict.LocalValue, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="{DynamicResource Remote}" Foreground="{DynamicResource RemoteTextBrush}" />
                <TextBox Text="{Binding SelectedConflict.RemoteValue, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="6" RowSpacing="6" Margin="0,4,0,0">
                  <Button Content="{DynamicResource UseLocal}" Command="{Binding UseLocalCommand}" />
                  <Button Grid.Column="1" Content="{DynamicResource UseRemote}"
                          Command="{Binding UseRemoteCommand}" />
                  <Button Grid.Row="1" Grid.ColumnSpan="2" Content="{DynamicResource UseBoth}"
                          Command="{Binding UseBothCommand}" />
                </Grid>

                <TextBlock Classes="label" Text="{DynamicResource CustomValue}" Margin="0,4,0,0" />
                <TextBox Classes="compact" Text="{Binding CustomValue, Mode=TwoWay}"
                         PlaceholderText="{DynamicResource CustomValue}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="80" />
                <Button Content="{DynamicResource UseCustom}" Command="{Binding UseCustomCommand}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="4" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
            Padding="10,4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
        <TextBlock Grid.Column="1" Text="{Binding GridDocument.Title}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
